# ==============================================================================
# SHIV AI SMART ROUTER ENVIRONMENT CONFIGURATION
# ==============================================================================

PROJECT_NAME="SHIV AI Smart Router"
VERSION="2.0.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000

# SHIV Database & Native Auth
SHIV_DATABASE_PATH="../shiv-database/shiv_dev.db"
SHIV_AUTH_JWT_SECRET="shiv-platform-super-secret-jwt-key-for-local-dev-12345"
SHIV_AUTH_JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# MULTI-PROVIDER 50+ API KEY ROTATION POOLS (Comma-separated keys)
# ==============================================================================
# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEYS=""

# Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEYS=""

# Cerebras Cloud (https://cloud.cerebras.ai)
CEREBRAS_API_KEYS=""

# SambaNova Cloud (https://cloud.sambanova.ai)
SAMBANOVA_API_KEYS=""

# Mistral AI (https://console.mistral.ai)
MISTRAL_API_KEYS=""

# Hugging Face (https://huggingface.co/settings/tokens)
HUGGINGFACE_TOKENS=""

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEYS=""
